{{!--
    LAYER SETTINGS (Dynamic Ring, Light Source and effects)
    Shown when any layer other than the token is selected. Only the selected layer's fields are
    rendered; the editor keeps the other layers' values in memory (_ringData, _lightData and
    _effects) and copies them back from the form whenever it previews, saves or re-renders.
--}}
<section class="visage-layer-settings" data-layer="{{inspector.type}}" aria-label="{{inspector.title}}" {{#if (eq selectedLayer 'token')}}hidden{{/if}}>
    <input type="hidden" name="inspector.effectId" value="{{inspector.id}}">

    <header class="visage-settings-header">
        <i class="{{inspector.icon}}"></i>
        <h3 class="visage-settings-title">{{inspector.title}}</h3>

        {{#if inspector.id}}
            {{!-- Effect controls. The eye is repeated from the layer row for convenience. --}}
            {{#if inspector.canLoop}}
                <button type="button" class="visage-icon-btn {{#if inspector.loop}}active{{/if}}" data-action="toggleLoop" data-effect-id="{{inspector.id}}" aria-pressed="{{#if inspector.loop}}true{{else}}false{{/if}}" data-tooltip="{{localize 'VISAGE.Editor.Effects.Loop'}}" aria-label="{{localize 'VISAGE.Editor.Effects.Loop'}}">
                    <i class="visage-icon repeat"></i>
                </button>
            {{/if}}
            <button type="button" class="visage-icon-btn" data-action="toggleEffect" data-effect-id="{{inspector.id}}" aria-pressed="{{#if inspector.disabled}}false{{else}}true{{/if}}" data-tooltip="{{localize 'VISAGE.Editor.Layers.ToggleVisibility'}}" aria-label="{{localize 'VISAGE.Editor.Layers.ToggleVisibility'}}">
                <i class="visage-icon {{#if inspector.disabled}}visage-hidden{{else}}visible{{/if}}"></i>
            </button>
            <button type="button" class="visage-icon-btn danger" data-action="deleteEffect" data-effect-id="{{inspector.id}}" data-tooltip="{{localize 'VISAGE.Editor.Layers.Delete'}}" aria-label="{{localize 'VISAGE.Editor.Layers.Delete'}}">
                <i class="visage-icon delete"></i>
            </button>
        {{else if (eq inspector.type 'ring')}}
            <button type="button" class="visage-icon-btn" data-action="toggleRing" aria-pressed="{{#if ring.active}}true{{else}}false{{/if}}" data-tooltip="{{localize 'VISAGE.Editor.Layers.ToggleVisibility'}}" aria-label="{{localize 'VISAGE.Editor.Layers.ToggleVisibility'}}">
                <i class="visage-icon {{#if ring.active}}visible{{else}}visage-hidden{{/if}}"></i>
            </button>
        {{else if (eq inspector.type 'light')}}
            <button type="button" class="visage-icon-btn" data-action="toggleLight" aria-pressed="{{#if light.active}}true{{else}}false{{/if}}" data-tooltip="{{localize 'VISAGE.Editor.Layers.ToggleVisibility'}}" aria-label="{{localize 'VISAGE.Editor.Layers.ToggleVisibility'}}">
                <i class="visage-icon {{#if light.active}}visible{{else}}visage-hidden{{/if}}"></i>
            </button>
        {{/if}}

        <button type="button" class="visage-icon-btn" data-action="toggleAllSections" data-tooltip="{{localize 'VISAGE.Editor.Sections.ToggleAll'}}" aria-label="{{localize 'VISAGE.Editor.Sections.ToggleAll'}}">
            <i class="visage-icon list"></i>
        </button>
    </header>

    {{!-- Explains what switching this layer off means: the ring and light keep their settings,
          while a switched-off effect is not saved --}}
    {{#if inspector.isOff}}
        <p class="visage-settings-note"><i class="visage-icon visage-hidden"></i> {{#if inspector.offNote}}{{localize inspector.offNote}}{{else}}{{localize "VISAGE.Editor.Layers.OffNote"}}{{/if}}</p>
    {{/if}}

    {{!-- ================= DYNAMIC RING ================= --}}
    {{#if (eq inspector.type 'ring')}}
        <details class="visage-section" data-section="ring-colors" open>
            <summary class="visage-section-summary">
                <span class="visage-section-heading"><span class="visage-section-title">{{localize "VISAGE.Editor.Sections.Colors"}}</span></span>
            </summary>
            <div class="visage-section-body">
                <div class="form-group">
                    <label>{{localize "VISAGE.RingConfig.RingColor"}}</label>
                    <div class="visage-form-fields">
                        <color-picker name="ringColor" value="{{ring.colors.ring}}"></color-picker>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "VISAGE.RingConfig.BackgroundColor"}}</label>
                    <div class="visage-form-fields">
                        <color-picker name="ringBackgroundColor" value="{{ring.colors.background}}"></color-picker>
                    </div>
                </div>
            </div>
        </details>

        <details class="visage-section" data-section="ring-subject" open>
            <summary class="visage-section-summary">
                <span class="visage-section-heading"><span class="visage-section-title">{{localize "VISAGE.Editor.Sections.Subject"}}</span></span>
            </summary>
            <div class="visage-section-body">
                <div class="form-group">
                    <label>{{localize "VISAGE.RingConfig.SubjectTexture"}}</label>
                    <div class="visage-form-fields">
                        <file-picker type="image" name="ringSubjectTexture" value="{{this.ring.subject.texture}}"></file-picker>
                    </div>
                </div>

                {{!-- The subject scale has no upper limit, so the value chip is a number that accepts
                      anything typed into it; the slider covers the common range --}}
                {{> "modules/visage/templates/parts/visage-range.hbs" editable=true numberName="ringSubjectScale" label="VISAGE.RingConfig.SubjectScale" value=ring.subject.scale min=0.5 max=3 step=0.1 default=1}}
            </div>
        </details>

        <details class="visage-section" data-section="ring-effects" open>
            <summary class="visage-section-summary">
                <span class="visage-section-heading"><span class="visage-section-title">{{localize "VISAGE.RingConfig.Effects.Label"}}</span></span>
            </summary>
            <div class="visage-section-body">
                <div class="visage-form-fields effects-grid">
                    {{#each ring.effects}}
                    <label class="checkbox">
                        <input class="visage-checkbox" type="checkbox" name="effect_{{this.value}}" {{checked this.isActive}}>
                        {{localize this.label}}
                    </label>
                    {{/each}}
                </div>
            </div>
        </details>
    {{/if}}

    {{!-- ================= LIGHT SOURCE ================= --}}
    {{#if (eq inspector.type 'light')}}
        <details class="visage-section" data-section="light-light" open>
            <summary class="visage-section-summary">
                <span class="visage-section-heading"><span class="visage-section-title">{{localize "VISAGE.Editor.Sections.Light"}}</span></span>
            </summary>
            <div class="visage-section-body">
                {{!-- RMU LIGHTING AND VISION INTEGRATION Part 1 --}}
                {{#if @root.isRMUActive}}
                <div class="form-group">
                    <label data-tooltip="{{localize 'rmu.light.baseIlluminationHint'}}">{{localize "rmu.light.baseIllumination"}}</label>
                    <div class="visage-form-fields">
                        <input type="hidden" name="rmu_active" value="true">
                        <select name="flags.rmu-lighting-vision.baseIllumination">
                            <option value="-1" {{visageSelected (eq @root.rmu.baseIllumination "-1")}}>{{localize "rmu.light.tiers.none"}}</option>
                            <option value="0" {{visageSelected (eq @root.rmu.baseIllumination "0")}}>{{localize "rmu.light.tiers.bright"}}</option>
                            <option value="1" {{visageSelected (eq @root.rmu.baseIllumination "1")}}>{{localize "rmu.light.tiers.uneven"}}</option>
                            <option value="2" {{visageSelected (eq @root.rmu.baseIllumination "2")}}>{{localize "rmu.light.tiers.dim"}}</option>
                            <option value="3" {{visageSelected (eq @root.rmu.baseIllumination "3")}}>{{localize "rmu.light.tiers.shadowy"}}</option>
                            <option value="4" {{visageSelected (eq @root.rmu.baseIllumination "4")}}>{{localize "rmu.light.tiers.dark"}}</option>
                            <option value="5" {{visageSelected (eq @root.rmu.baseIllumination "5")}}>{{localize "rmu.light.tiers.extremelyDark"}}</option>
                            <option value="6" {{visageSelected (eq @root.rmu.baseIllumination "6")}}>{{localize "rmu.light.tiers.pitchBlack"}}</option>
                        </select>
                    </div>
                </div>
                {{/if}}

                {{!-- DIM / BRIGHT RADIUS --}}
                <div class="form-group fade-grid">
                    <label>{{localize "VISAGE.Editor.Light.Dim"}}</label>
                    <input type="number" name="light.dim" value="{{light.dim}}" step="0.5">
                    <label>{{localize "VISAGE.Editor.Light.Bright"}}</label>
                    <input type="number" name="light.bright" value="{{light.bright}}" step="0.5">
                </div>

                {{!-- RMU LIGHTING AND VISION INTEGRATION Part 2 --}}
                {{#if @root.isRMUActive}}
                <div class="form-group">
                    <label>{{localize "VISAGE.Editor.Light.RmuModifiers"}}</label>
                    <div class="visage-form-fields stacked">
                        <label class="checkbox" data-tooltip="{{localize 'rmu.light.isMagicalHint'}}">
                            <input class="visage-checkbox" type="checkbox" name="flags.rmu-lighting-vision.isMagical" {{checked @root.rmu.isMagical}}>
                            {{localize "rmu.light.isMagical"}}
                        </label>
                        <label class="checkbox" data-tooltip="{{localize 'rmu.light.isUtter.hint'}}">
                            <input class="visage-checkbox" type="checkbox" name="flags.rmu-lighting-vision.isUtter" {{checked @root.rmu.isUtter}}>
                            {{localize "rmu.light.isUtter.name"}}
                        </label>
                        <label class="checkbox" data-tooltip="{{localize 'rmu.light.isConstant.hint'}}">
                            <input class="visage-checkbox" type="checkbox" name="flags.rmu-lighting-vision.isConstant" {{checked @root.rmu.isConstant}}>
                            {{localize "rmu.light.isConstant.name"}}
                        </label>
                    </div>
                </div>
                {{/if}}

                <div class="form-group">
                    <label>{{localize "VISAGE.Editor.Light.Color"}}</label>
                    <div class="visage-form-fields">
                        <color-picker name="light.color" value="{{light.color}}"></color-picker>
                    </div>
                </div>

                {{> "modules/visage/templates/parts/visage-range.hbs" name="light.alpha" label="VISAGE.Editor.Light.ColorIntensity" value=light.alpha min=0 max=1 step=0.05 default=0.5}}

                {{> "modules/visage/templates/parts/visage-range.hbs" name="light.luminosity" label="VISAGE.Editor.Light.Luminosity" hint="VISAGE.Editor.Light.LuminosityHint" value=light.luminosity min=-1 max=1 step=0.05 default=0.5}}

                {{> "modules/visage/templates/parts/visage-range.hbs" name="light.angle" label="VISAGE.Editor.Light.Angle" value=light.angle min=0 max=360 step=1 default=360 unit="°"}}

                <div class="form-group">
                    <label data-tooltip="{{localize 'VISAGE.Editor.Light.PriorityHint'}}">{{localize "VISAGE.Editor.Light.Priority"}} <i class="visage-icon info"></i></label>
                    <div class="visage-form-fields">
                        <input type="number" name="light.priority" value="{{light.priority}}" step="1" placeholder="0">
                    </div>
                </div>
            </div>
        </details>

        <details class="visage-section" data-section="light-animation" open>
            <summary class="visage-section-summary">
                <span class="visage-section-heading"><span class="visage-section-title">{{localize "VISAGE.Editor.Sections.Animation"}}</span></span>
            </summary>
            <div class="visage-section-body">
                <div class="form-group">
                    <label data-tooltip="{{localize 'VISAGE.Editor.Light.AnimationHint'}}">
                        {{localize "VISAGE.Editor.Light.AnimationType"}} <i class="visage-icon info"></i>
                    </label>
                    <div class="visage-form-fields">
                        <select name="light.animation.type">
                            {{selectOptions lightAnimationOptions selected=light.animation.type}}
                        </select>
                    </div>
                </div>

                {{> "modules/visage/templates/parts/visage-range.hbs" name="light.animation.speed" label="VISAGE.Editor.Light.Speed" value=light.animation.speed min=1 max=10 step=1 default=5}}

                {{> "modules/visage/templates/parts/visage-range.hbs" name="light.animation.intensity" label="VISAGE.Editor.Light.Intensity" value=light.animation.intensity min=1 max=10 step=1 default=5}}
            </div>
        </details>
    {{/if}}

    {{!-- ================= VISUAL AND AUDIO EFFECTS: SOURCE ================= --}}
    {{#if (or (eq inspector.type 'visual') (eq inspector.type 'audio'))}}
        <details class="visage-section" data-section="effect-source" open>
            <summary class="visage-section-summary">
                <span class="visage-section-heading"><span class="visage-section-title">{{localize "VISAGE.Editor.Sections.Source"}}</span></span>
            </summary>
            <div class="visage-section-body">
                <div class="form-group">
                    <label>{{localize "VISAGE.GlobalEditor.Label"}}</label>
                    <div class="visage-form-fields">
                        <input type="text" name="effectLabel" value="{{inspector.label}}" placeholder="{{localize 'VISAGE.Editor.Effects.PathPlaceholder'}}">
                    </div>
                </div>

                <div class="form-group">
                    <label>{{localize "VISAGE.Editor.Effects.Path"}}</label>
                    <div class="visage-form-fields">
                        <input type="text" name="effectPath" value="{{inspector.path}}" placeholder="e.g. jb2a.fire_bolt.red">

                        <button type="button" data-action="openSequencerDatabase" data-tooltip="{{#if @root.hasSequencer}}{{localize 'VISAGE.Editor.Effects.OpenDatabase'}}{{else}}{{localize 'VISAGE.Editor.Effects.DisabledDatabase'}}{{/if}}" {{#unless @root.hasSequencer}}disabled{{/unless}}>
                            <i class="visage-icon library"></i>
                        </button>

                        <button type="button" class="file-picker-button" data-action="openFilePicker" data-file-type="{{#if (eq inspector.type 'audio')}}audio{{else}}imagevideo{{/if}}" data-tooltip="{{localize 'VISAGE.Editor.Effects.OpenFile'}}">
                            <i class="visage-icon open"></i>
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label>{{localize "VISAGE.Editor.Effects.Delay"}}</label>
                    <div class="visage-form-fields">
                        <input type="number" name="effectDelay" value="{{inspector.delay}}" step="0.1" placeholder="0">
                    </div>
                </div>
            </div>
        </details>
    {{/if}}

    {{!-- ================= VISUAL EFFECTS ================= --}}
    {{#if (eq inspector.type 'visual')}}
        <details class="visage-section" data-section="effect-placement" open>
            <summary class="visage-section-summary">
                <span class="visage-section-heading"><span class="visage-section-title">{{localize "VISAGE.Editor.Sections.Placement"}}</span></span>
            </summary>
            <div class="visage-section-body">
                {{!-- Changing this moves the effect between the Above and Below groups in the list --}}
                <div class="form-group">
                    <label>{{localize "VISAGE.Editor.Effects.Layering"}}</label>
                    <div class="visage-form-fields">
                        <div class="visage-mode-toggle">
                            <input type="radio" name="effectZIndex" id="z-above-{{@root.appId}}" value="above" {{checked (eq inspector.zOrder "above")}}>
                            <label class="visage-btn-first" for="z-above-{{@root.appId}}">{{localize "VISAGE.Editor.Effects.Above"}}</label>
                            <input type="radio" name="effectZIndex" id="z-below-{{@root.appId}}" value="below" {{checked (eq inspector.zOrder "below")}}>
                            <label class="visage-btn-second" for="z-below-{{@root.appId}}">{{localize "VISAGE.Editor.Effects.Below"}}</label>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label>{{localize "VISAGE.Config.List.Scale"}}</label>
                    <div class="visage-form-fields">
                        <input type="number" name="effectScale" value="{{inspector.scale}}" step="10">
                    </div>
                </div>

                <div class="form-group rotation-group">
                    <label>{{localize "VISAGE.Rotation.Label"}}</label>
                    <div class="visage-form-fields">
                        <input type="number" name="effectRotation" value="{{inspector.rotation}}" placeholder="0">
                        <label class="rotation-random-toggle">
                            <input type="checkbox" name="effectRotationRandom" class="visage-checkbox" {{checked inspector.rotationRandom}}>
                            {{localize "VISAGE.Random"}}
                        </label>
                    </div>
                </div>

                <label class="visage-check-row" data-tooltip="{{localize 'VISAGE.Editor.Effects.BindRotationHint'}}">
                    <input type="checkbox" name="effectBindRotation" class="visage-checkbox" {{checked inspector.bindRotation}}>
                    {{localize "VISAGE.Editor.Effects.BindRotation"}} <i class="visage-icon info"></i>
                </label>

                {{!-- Offsets can go beyond the slider's range, so the value chip is a number that
                      accepts anything typed into it --}}
                {{> "modules/visage/templates/parts/visage-range.hbs" editable=true numberName="effectOffsetX" label="VISAGE.Editor.Effects.OffsetX" hint="VISAGE.Editor.Effects.OffsetHint" value=inspector.offsetX min=-2 max=2 step=0.1 default=0}}

                {{> "modules/visage/templates/parts/visage-range.hbs" editable=true numberName="effectOffsetY" label="VISAGE.Editor.Effects.OffsetY" hint="VISAGE.Editor.Effects.OffsetHint" value=inspector.offsetY min=-2 max=2 step=0.1 default=0}}

                <label class="visage-check-row" data-tooltip="{{localize 'VISAGE.Editor.Effects.BindToSpriteHint'}}">
                    <input type="checkbox" name="effectBindToSprite" class="visage-checkbox" {{checked inspector.bindToSprite}}>
                    {{localize "VISAGE.Editor.Effects.BindToSprite"}} <i class="visage-icon info"></i>
                </label>
            </div>
        </details>

        <details class="visage-section" data-section="effect-look" open>
            <summary class="visage-section-summary">
                <span class="visage-section-heading"><span class="visage-section-title">{{localize "VISAGE.Editor.Sections.Look"}}</span></span>
            </summary>
            <div class="visage-section-body">
                {{> "modules/visage/templates/parts/visage-range.hbs" name="effectOpacity" label="VISAGE.Config.Opacity.Label" hint="VISAGE.Editor.Effects.RelativeOpacityHint" value=inspector.opacity min=0 max=1 step=0.1 default=1}}

                <div class="form-group">
                    <label>{{localize "VISAGE.Editor.Effects.BlendMode"}}</label>
                    <div class="visage-form-fields">
                        <select name="effectBlendMode">
                            <option value="normal" {{visageSelected (eq inspector.blendMode "normal")}}>{{localize "VISAGE.BlendMode.Normal"}}</option>
                            <option value="screen" {{visageSelected (eq inspector.blendMode "screen")}}>{{localize "VISAGE.BlendMode.Screen"}}</option>
                            <option value="multiply" {{visageSelected (eq inspector.blendMode "multiply")}}>{{localize "VISAGE.BlendMode.Multiply"}}</option>
                            <option value="overlay" {{visageSelected (eq inspector.blendMode "overlay")}}>{{localize "VISAGE.BlendMode.Overlay"}}</option>
                            <option value="lighten" {{visageSelected (eq inspector.blendMode "lighten")}}>{{localize "VISAGE.BlendMode.Lighten"}}</option>
                            <option value="darken" {{visageSelected (eq inspector.blendMode "darken")}}>{{localize "VISAGE.BlendMode.Darken"}}</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label>{{localize "VISAGE.Editor.Effects.Tint"}}</label>
                    <div class="visage-form-fields">
                        <color-picker name="effectTint" value="{{inspector.tint}}"></color-picker>
                    </div>
                </div>
            </div>
        </details>

        {{!-- ADVANCED SEQUENCER EFFECTS. The heading is highlighted while any of these are set, so
              they are not missed while the section is collapsed. --}}
        <details class="visage-section {{#if inspector.hasAdvancedSettings}}active-settings{{/if}}" data-section="effect-advanced">
            <summary class="visage-section-summary">
                <span class="visage-section-heading"><span class="visage-section-title">{{localize "VISAGE.Editor.Effects.AdvancedSequencer"}}</span></span>
            </summary>
            <div class="visage-section-body">
                {{!-- GROUP: Rendering & Playback --}}
                <h4 class="visage-subheading">{{localize "VISAGE.Editor.Effects.GroupRender"}}</h4>
                <label class="visage-check-row">
                    <input type="checkbox" name="effectMaskToToken" class="visage-checkbox" {{checked inspector.maskToToken}}>
                    {{localize "VISAGE.Editor.Effects.MaskToToken"}} <i class="visage-icon info" data-tooltip="{{localize 'VISAGE.Editor.Effects.MaskToTokenHint'}}"></i>
                </label>
                <label class="visage-check-row">
                    <input type="checkbox" name="effectConstrainedByWalls" class="visage-checkbox" {{checked inspector.constrainedByWalls}}>
                    {{localize "VISAGE.Editor.Effects.ConstrainedByWalls"}}
                </label>

                {{!-- GROUP: Fade Transitions --}}
                <h4 class="visage-subheading">{{localize "VISAGE.Editor.Effects.GroupFade"}}</h4>
                <div class="form-group">
                    <label>{{localize "VISAGE.Editor.Effects.Duration"}}</label>
                    <div class="visage-form-fields">
                        <input type="number" name="effectFadeIn" value="{{inspector.fadeIn}}" step="100" placeholder="{{localize 'VISAGE.Editor.Effects.In'}}">
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "VISAGE.Editor.Effects.Easing"}}</label>
                    <div class="visage-form-fields">
                        <select name="effectFadeEase">
                            {{selectOptions easingChoices selected=inspector.fadeEase blank="Linear (Default)"}}
                        </select>
                    </div>
                </div>

                {{!-- GROUP: Scale Transitions --}}
                <h4 class="visage-subheading">{{localize "VISAGE.Editor.Effects.GroupScale"}}</h4>
                <div class="form-group">
                    <label>{{localize "VISAGE.Editor.Effects.Duration"}}</label>
                    <div class="visage-form-fields">
                        <input type="number" name="effectScaleInDuration" value="{{inspector.scaleInDuration}}" step="100" placeholder="{{localize 'VISAGE.Editor.Effects.In'}}">
                    </div>
                </div>
                <div class="form-group">
                    <label data-tooltip="{{localize 'VISAGE.Editor.Effects.ScaleHint'}}">
                        {{localize "VISAGE.Editor.Effects.Multiplier"}} <i class="visage-icon info"></i>
                    </label>
                    <div class="visage-form-fields">
                        <input type="number" name="effectScaleIn" value="{{inspector.scaleIn}}" step="0.1" placeholder="{{localize 'VISAGE.Editor.Effects.In'}}">
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "VISAGE.Editor.Effects.Easing"}}</label>
                    <div class="visage-form-fields">
                        <select name="effectScaleEase">
                            {{selectOptions easingChoices selected=inspector.scaleEase blank="Linear (Default)"}}
                        </select>
                    </div>
                </div>
            </div>
        </details>
    {{/if}}

    {{!-- ================= AUDIO EFFECTS ================= --}}
    {{#if (eq inspector.type 'audio')}}
        <details class="visage-section" data-section="effect-playback" open>
            <summary class="visage-section-summary">
                <span class="visage-section-heading"><span class="visage-section-title">{{localize "VISAGE.Editor.Sections.Playback"}}</span></span>
            </summary>
            <div class="visage-section-body">
                {{> "modules/visage/templates/parts/visage-range.hbs" name="effectVolume" label="VISAGE.Editor.Effects.Volume" value=inspector.opacity min=0 max=1 step=0.1 default=1}}

                <div class="form-group fade-grid">
                    <label>{{localize "VISAGE.Editor.Effects.FadeIn"}}</label>
                    <input type="number" name="effectFadeIn" value="{{inspector.fadeIn}}" step="100" placeholder="0">
                    <label>{{localize "VISAGE.Editor.Effects.FadeOut"}}</label>
                    <input type="number" name="effectFadeOut" value="{{inspector.fadeOut}}" step="100" placeholder="0">
                </div>
            </div>
        </details>
    {{/if}}

    {{!-- ================= TOKENMAGIC FILTERS ================= --}}
    {{#if (eq inspector.type 'tmfx')}}
        <p class="visage-settings-note"><i class="visage-icon info"></i> {{localize "VISAGE.Editor.Effects.TmfxPreviewNote"}}</p>

        <details class="visage-section" data-section="effect-filter" open>
            <summary class="visage-section-summary">
                <span class="visage-section-heading"><span class="visage-section-title">{{localize "VISAGE.Editor.Sections.Filter"}}</span></span>
            </summary>
            <div class="visage-section-body">
                <div class="form-group">
                    <label>{{localize "VISAGE.GlobalEditor.Label"}}</label>
                    <div class="visage-form-fields">
                        <input type="text" name="effectLabel" value="{{inspector.label}}" placeholder="Filter Name">
                    </div>
                </div>

                <div class="form-group">
                    <label>{{localize "VISAGE.Editor.Effects.TmfxPresetLabel"}}</label>
                    <div class="visage-form-fields">
                        <select name="effectTmfxPreset">
                            <option value="">{{localize "VISAGE.Editor.Effects.SelectPreset"}}</option>

                            <optgroup label="{{localize 'VISAGE.Editor.Effects.CorePresets'}}">
                                {{#each tmfxPresets.corePresets}}
                                    <option value="{{this.id}}" {{visageSelected (eq ../inspector.tmfxPreset this.id)}}>{{this.name}}</option>
                                {{/each}}
                            </optgroup>

                            {{#if tmfxPresets.galleryPresets.length}}
                            <optgroup label="{{localize 'VISAGE.Editor.Effects.CommunityGallery'}}">
                                {{#each tmfxPresets.galleryPresets}}
                                    <option value="{{this.id}}" {{visageSelected (eq ../inspector.tmfxPreset this.id)}}>{{this.name}}</option>
                                {{/each}}
                            </optgroup>
                            {{/if}}
                        </select>
                    </div>
                </div>

                <div class="form-group custom-payload-group">
                    <label>{{localize "VISAGE.Editor.Effects.TmfxPayload"}}</label>
                    <p class="hint">{{localize "VISAGE.Editor.Effects.TmfxPayloadHint"}}</p>
                    <textarea class="visage-scrollable" name="effectTmfxPayload" rows="6" placeholder='[{ "filterType": "glow", "color": 0xFF0000 }]'></textarea>
                    <div class="payload-button-row">
                        <button type="button" data-action="formatTmfxPayload" class="format-json-btn">
                            <i class="visage-icon wand-stars"></i> {{localize "VISAGE.Editor.Effects.TmfxFormatJson"}}
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label>{{localize "VISAGE.Editor.Effects.Delay"}}</label>
                    <div class="visage-form-fields">
                        <input type="number" name="effectDelay" value="{{inspector.delay}}" step="0.1" placeholder="0">
                    </div>
                </div>
            </div>
        </details>
    {{/if}}

    {{!-- ================= MACROS ================= --}}
    {{#if (eq inspector.type 'macro')}}
        <details class="visage-section" data-section="effect-macro" open>
            <summary class="visage-section-summary">
                <span class="visage-section-heading"><span class="visage-section-title">{{localize "VISAGE.Editor.Sections.Macro"}}</span></span>
            </summary>
            <div class="visage-section-body">
                <div class="form-group">
                    <label>{{localize "VISAGE.GlobalEditor.Label"}}</label>
                    <div class="visage-form-fields">
                        <input type="text" name="effectLabel" value="{{inspector.label}}" placeholder="Macro Name">
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "VISAGE.Editor.Effects.MacroUUID"}}</label>
                    <div class="visage-form-fields">
                        <input type="text" name="effectUuid" value="{{inspector.uuid}}" placeholder="Macro.xxxxxxxxxxxx">
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "VISAGE.Editor.Effects.Delay"}}</label>
                    <div class="visage-form-fields">
                        <input type="number" name="effectDelay" value="{{inspector.delay}}" step="0.1" placeholder="0">
                    </div>
                </div>
            </div>
        </details>
    {{/if}}
</section>

{{!--
    AUTOMATION
    The rule is written as a sentence: "Apply this Visage while all/any of these are true", followed
    by one card per condition, each edited in place as a sentence of its own. A Visage holds one
    rule; it describes a state rather than a moment, so the Visage stays applied for as long as the
    conditions are true and is removed when they stop being true.

    The summary at the bottom is rewritten by the editor whenever a condition changes, using
    VisageAutomationText (the same sentence appears as a tooltip in the Gallery and Selector HUD).
--}}
<section class="visage-automation" aria-label="{{localize 'VISAGE.Editor.Tabs.Triggers'}}">

    <header class="visage-automation-header">
        {{!-- The same power toggle as on Gallery cards and Selector HUD tiles: green while
              automation is on, greyed out while it is off --}}
        <button type="button" class="visage-card-effect-indicator automation visage-automation-toggle {{#unless automation.enabled}}muted{{/unless}}" data-action="toggleAutomation" aria-pressed="{{#if automation.enabled}}true{{else}}false{{/if}}" aria-labelledby="visage-automation-enable-{{appId}}" data-tooltip="{{localize 'VISAGE.Automation.Text.ClickToToggle'}}">
            <i class="visage-icon power"></i>
        </button>
        <span class="visage-automation-enable" id="visage-automation-enable-{{appId}}">{{localize "VISAGE.Automation.Editor.Enable"}}</span>

        <span class="visage-header-spacer"></span>

        <label class="visage-automation-priority" for="visage-priority-{{appId}}" data-tooltip="{{localize 'VISAGE.Editor.Triggers.PriorityHint'}}">
            {{localize "VISAGE.Editor.Triggers.Priority"}} <i class="visage-icon info"></i>
        </label>
        <input type="number" id="visage-priority-{{appId}}" class="visage-sentence-number" name="automation.onEnter.priority" value="{{automation.onEnter.priority}}" step="1">
    </header>

    {{!-- The rule stays editable while automation is off; it just is not applied --}}
    {{#unless automation.enabled}}
        <p class="visage-settings-note visage-automation-off-note"><i class="visage-icon power"></i> {{localize "VISAGE.Automation.Editor.OffNote"}}</p>
    {{/unless}}

    <div class="visage-automation-body visage-scrollable">

        {{!-- The rule's lead sentence, with the all / any switch inline --}}
        <p class="visage-automation-lead">
            {{localize "VISAGE.Automation.Editor.LeadStart"}}
            <span class="logic-toggle" role="group" data-tooltip="{{localize 'VISAGE.Editor.Triggers.LogicHint'}}">
                <button type="button" class="logic-toggle-btn {{#if (eq automation.logic 'AND')}}active{{/if}}" data-action="toggleLogic" data-value="AND" aria-pressed="{{#if (eq automation.logic 'AND')}}true{{else}}false{{/if}}">
                    {{localize "VISAGE.Automation.Editor.LogicAll"}}
                </button>
                <button type="button" class="logic-toggle-btn {{#if (eq automation.logic 'OR')}}active{{/if}}" data-action="toggleLogic" data-value="OR" aria-pressed="{{#if (eq automation.logic 'OR')}}true{{else}}false{{/if}}">
                    {{localize "VISAGE.Automation.Editor.LogicAny"}}
                </button>
            </span>
            {{localize "VISAGE.Automation.Editor.LeadEnd"}}
        </p>

        <div class="visage-condition-list">
            {{#each automationConditions}}
                {{> "modules/visage/templates/parts/visage-condition-card.hbs" this}}
            {{else}}
                <p class="visage-settings-note">{{localize "VISAGE.Editor.Triggers.Empty"}}</p>
            {{/each}}
        </div>

        <div class="visage-condition-add">
            <span class="visage-group-label">{{localize "VISAGE.Automation.Editor.AddCondition"}}</span>
            <button type="button" data-action="addCondition" data-type="attribute">
                <i class="visage-icon add"></i> {{localize "VISAGE.Editor.Triggers.AddAttribute"}}
            </button>
            <button type="button" data-action="addCondition" data-type="status">
                <i class="visage-icon add"></i> {{localize "VISAGE.Editor.Triggers.AddStatus"}}
            </button>
            <button type="button" data-action="addCondition" data-type="event">
                <i class="visage-icon add"></i> {{localize "VISAGE.Editor.Triggers.AddEvent"}}
            </button>
        </div>

        <p class="visage-settings-note visage-automation-hint">
            <i class="visage-icon info"></i>
            <span>{{localize "VISAGE.Automation.Editor.OneRuleHint"}}</span>
        </p>
    </div>

    <footer class="visage-automation-summary" aria-live="polite">
        <span class="visage-group-label">{{localize "VISAGE.Automation.Editor.InWords"}}</span>
        <p class="visage-automation-summary-text">{{automationSummary}}</p>
    </footer>
</section>
